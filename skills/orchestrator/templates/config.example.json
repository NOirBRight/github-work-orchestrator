{
  "schema_version": 1,
  "global": {
    "default_tier": "standard",
    "execution_slots": 3,
    "integration_wip_limit": 6,
    "max_attempts": 2,
    "intake": {
      "include_labels": ["ready-for-agent"],
      "human_labels": ["ready-for-human"],
      "clarify_labels": ["needs-info"],
      "candidate_limit": 100,
      "ready_reserve_target": 6
    }
  },
  "tiers": {
    "light": {
      "provider": "your-provider",
      "settings": {
        "model": "your-fast-model",
        "thinkingOptionId": "low",
        "modeId": "your-unattended-mode",
        "features": {}
      }
    },
    "standard": {
      "provider": "your-provider",
      "settings": {
        "model": "your-default-model",
        "thinkingOptionId": "medium",
        "modeId": "your-unattended-mode",
        "features": {}
      }
    },
    "heavy": {
      "provider": "your-provider",
      "settings": {
        "model": "your-strongest-model",
        "thinkingOptionId": "high",
        "modeId": "your-unattended-mode",
        "features": {}
      }
    }
  },
  "reviewer_tiers": {
    "standard": "standard",
    "strict": "heavy"
  },
  "repositories": {
    "owner/repo": {
      "integration_branch": "dev",
      "workspace_id": "paseo-stable-workspace-id",
      "merge_method": "squash",
      "execution_slots": 3,
      "integration_wip_limit": 6,
      "default_tier": "standard",
      "milestone_tiers": {},
      "tiers": {},
      "project_number": null
    }
  }
}
